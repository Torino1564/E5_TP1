# fpu.qip

set qip_path [file dirname [info script]]

set_global_assignment -name VERILOG_FILE "$qip_path/adder.v"
set_global_assignment -name VERILOG_FILE "$qip_path/divider.v"
set_global_assignment -name VERILOG_FILE "$qip_path/float_to_int.v"
set_global_assignment -name VERILOG_FILE "$qip_path/int_to_float.v"
set_global_assignment -name VERILOG_FILE "$qip_path/multiplier.v"
set_global_assignment -name SYSTEMVERILOG_FILE "$qip_path/fp_alu.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "$qip_path/fpu.sv"