		nillO = (a[2] & (~ nilOO)),
		nilOi = (a[1] & (~ nilOO)),
		nilOl = (a[0] & (~ nilOO)),
		nilOO = ((((((((~ a[23]) & (~ a[24])) & (~ a[25])) & (~ a[26])) & (~ a[27])) & (~ a[28])) & (~ a[29])) & (~ a[30])),
		niO0i = (b[19] & (~ nl1ll)),
		niO0l = (b[18] & (~ nl1ll)),
		niO0O = (b[17] & (~ nl1ll)),
		niO1i = (b[22] & (~ nl1ll)),
