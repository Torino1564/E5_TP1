	assign
		wire_n00i_ENA = en[0];
	and(wire_n01i_dataout, ((((~ (nl1Oi ^ nl1Ol)) & n00l) | (nl1Oi & (~ nl1Ol))) | nl1lO), (~ nl1OO));
	assign		wire_n0ll_dataout = (a[31] === 1'b1) ? (~ wire_n0Oi_o[33]) : (~ wire_n0lO_o[33]);
