		niiiO = (a[20] & (~ nilOO)),
		niili = (a[19] & (~ nilOO)),
		niill = (a[18] & (~ nilOO)),
		niilO = (a[17] & (~ nilOO)),
		niiOi = (a[16] & (~ nilOO)),
		niiOl = (a[15] & (~ nilOO)),
		niiOO = (a[14] & (~ nilOO)),
		nil0i = (a[10] & (~ nilOO)),
